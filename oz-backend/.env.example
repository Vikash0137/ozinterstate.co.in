# OZ Interstate Backend Environment Variables
PORT=5000
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=oz_interstate

# JWT Secret & Expiration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# MongoDB (optional) — do NOT put real secrets here
MONGODB_URI=mongodb://127.0.0.1:27017/oz_interstate
NODE_ENV=development

# File Upload Configuration
MAX_FILE_SIZE=104857600

# Admin seed defaults (do NOT use real credentials in .env.example)
ADMIN_NAME=OZ Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
